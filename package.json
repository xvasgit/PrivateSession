{
  "name": "private-session",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests scripts prisma/*.ts *.json *.mjs *.ts .github/workflows/*.yml",
    "format:check": "prettier --check app components lib tests scripts prisma/*.ts *.json *.mjs *.ts .github/workflows/*.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:ui": "node scripts/audit-ui.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-lab-db.ts",
    "db:test": "tsx scripts/test-meeting-db.ts",
    "postinstall": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "auth:bootstrap": "tsx scripts/bootstrap-accounts.ts",
    "test:access": "tsx scripts/test-access.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.18",
    "dotenv": "^18.0.9",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "serve": "14.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
