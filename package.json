{
  "name": "private-session",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "serve out --listen tcp://127.0.0.1:3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests scripts *.json *.mjs *.ts .github/workflows/*.yml",
    "format:check": "prettier --check app components lib tests scripts *.json *.mjs *.ts .github/workflows/*.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:ui": "node scripts/audit-ui.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "serve": "14.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
